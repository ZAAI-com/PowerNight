# PowerNight Docker Build Ignore

# Development files
.git/
.github/
.gitignore
.env*
.vscode/
.idea/
*.pyc
__pycache__/
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt

# Task Master AI files (not needed in container)
.taskmaster/
.claude/
.mcp.json
CLAUDE.md

# Test files
tests/
test_*.py
*_test.py
pytest.ini
.pytest_cache/
.coverage
htmlcov/
.tox/

# Documentation (except README)
docs/
*.md
!README.md

# Build artifacts
build/
*.egg-info/
.eggs/

# Virtual environments
venv/
env/
ENV/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Runtime data (will be mounted as volumes)
data/
logs/
backups/

# Development configs
# Note: config.example.* files are needed for container startup
docker-compose.override.yml
*.local.*

# Temporary files
*.tmp
*.log
*.swp
*.swo
*~

# Node.js (if any frontend build tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python virtual environments and caches
.mypy_cache/
.dmypy.json
dmypy.json